# Writes OUT = a header with the source checkout's commit (KAMITE_GIT_COMMIT), at every build (src/CMakeLists.txt
# kamite_git_commit); the header changes only when the commit does. "unknown" without git or a checkout.
execute_process(COMMAND git -C "${SRC}" rev-parse --short=7 HEAD
    OUTPUT_VARIABLE KAMITE_COMMIT OUTPUT_STRIP_TRAILING_WHITESPACE ERROR_QUIET RESULT_VARIABLE KAMITE_COMMIT_RESULT)
if(NOT KAMITE_COMMIT_RESULT EQUAL 0 OR KAMITE_COMMIT STREQUAL "")
    set(KAMITE_COMMIT "unknown")
endif()
file(WRITE "${OUT}.tmp" "// Generated by src/git_commit.cmake. Do not edit.\n#pragma once\n#define KAMITE_GIT_COMMIT \"${KAMITE_COMMIT}\"\n")
file(COPY_FILE "${OUT}.tmp" "${OUT}" ONLY_IF_DIFFERENT)
