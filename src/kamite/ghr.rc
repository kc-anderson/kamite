// The exe's version resource: Explorer's Details tab and Task Manager show the port's public name (the file is GHR.exe,
// the code and the build target stay "kamite"). The icon goes here too once the logo exists.
#include <winver.h>

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "God Hand: Rearmed"
            VALUE "ProductName", "God Hand: Rearmed"
            VALUE "InternalName", "kamite"
            VALUE "OriginalFilename", "GHR.exe"
            VALUE "Comments", "Unofficial fan-made native PC port of God Hand (PS2). Not affiliated with or endorsed by Capcom or Clover Studio."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
