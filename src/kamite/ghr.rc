// The exe's resources: its icon and version details, so Explorer and Task Manager show the port's public name (the file
// is GHR.exe; the code and the build target stay "kamite").
#include <winver.h>

// The icon (from assets/icon.svg: tools/icon/make_ico.py). Named GLFW_ICON because raylib's window (GLFW) takes the
// resource of that name for its title bar and taskbar icon; as the exe's only icon it is also the file's icon. The
// path is relative to src/, which is on the resource compiler's include path.
GLFW_ICON ICON "kamite/ghr.ico"

VS_VERSION_INFO VERSIONINFO
FILEVERSION 0,0,0,0
PRODUCTVERSION 0,0,0,0
FILEFLAGSMASK VS_FFI_FILEFLAGSMASK
FILEFLAGS 0x0L
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
FILESUBTYPE VFT2_UNKNOWN
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "God Hand: Rearmed"
            VALUE "ProductName", "God Hand: Rearmed"
            VALUE "InternalName", "kamite"
            VALUE "OriginalFilename", "GHR.exe"
            VALUE "Comments", "Unofficial fan-made native PC port of God Hand (PS2). Not affiliated with or endorsed by Capcom or Clover Studio."
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x409, 1200
    END
END
